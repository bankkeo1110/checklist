generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParentName {
  TINH
  LOAN
}

enum ChildName {
  OTIS
  LIAM
  TEST
}

enum TaskInstanceStatus {
  PENDING
  CLAIMED
  APPROVED
  REJECTED
  MISSED
}

model Child {
  id        String    @id @default(cuid())
  name      ChildName @unique
  label     String
  color     String
  pinHash   String
  createdAt DateTime  @default(now())

  // Set by a full "Reset toàn bộ" — reconcileMissedDaysForChild won't
  // backfill missed-day penalties for any date before this, so a reset
  // actually starts clean instead of immediately re-deriving the same old
  // "didn't check in" history for tasks that existed before the reset.
  historyResetAt DateTime? @db.Date

  tasks             Task[]             @relation("TaskAssignments")
  taskInstances     TaskInstance[]
  ledgerEntries     PointLedger[]
  weeklyGoals       WeeklyGoal[]
  bedtimeLogs       BedtimeLog[]
  wakeupLogs        WakeupLog[]
  subjectLogs       SubjectLog[]
  animalUnlocks     AnimalUnlock[]
  dragonBallUnlocks DragonBallUnlock[]
}

model Parent {
  id        String     @id @default(cuid())
  name      ParentName @unique
  label     String
  pinHash   String
  createdAt DateTime   @default(now())

  reviewedInstances TaskInstance[] @relation("ReviewedBy")
  ledgerApprovals   PointLedger[]  @relation("ApprovedBy")
}

model Task {
  id        String   @id @default(cuid())
  title     String
  points    Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo    Child[]        @relation("TaskAssignments")
  taskInstances TaskInstance[]
}

model TaskInstance {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  weekStart DateTime @db.Date

  status TaskInstanceStatus @default(PENDING)

  claimedAt  DateTime?
  reviewedAt DateTime?

  reviewedById String?
  reviewedBy   Parent? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  note String?

  ledgerEntries PointLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, childId, date])
  @@index([childId, weekStart])
  @@index([status])
}

model PointLedger {
  id String @id @default(cuid())

  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  taskInstanceId String?
  taskInstance   TaskInstance? @relation(fields: [taskInstanceId], references: [id], onDelete: SetNull)

  bedtimeLogId String?
  bedtimeLog   BedtimeLog? @relation(fields: [bedtimeLogId], references: [id], onDelete: SetNull)

  wakeupLogId String?
  wakeupLog   WakeupLog? @relation(fields: [wakeupLogId], references: [id], onDelete: SetNull)

  subjectLogId String?
  subjectLog   SubjectLog? @relation(fields: [subjectLogId], references: [id], onDelete: SetNull)

  delta  Int
  reason String

  approvedById String?
  approvedBy   Parent? @relation("ApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())

  @@index([childId, createdAt])
}

model WeeklyGoal {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  goalText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childId, weekStart])
}

model BedtimeItem {
  id        String   @id @default(cuid())
  label     String
  points    Int      @default(1)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  logs BedtimeLog[]
}

model BedtimeLog {
  id            String      @id @default(cuid())
  childId       String
  child         Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  bedtimeItemId String
  bedtimeItem   BedtimeItem @relation(fields: [bedtimeItemId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  checked       Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  ledgerEntries PointLedger[]

  @@unique([childId, bedtimeItemId, date])
}

model WakeupItem {
  id        String   @id @default(cuid())
  label     String
  points    Int      @default(1)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  logs WakeupLog[]
}

model WakeupLog {
  id           String     @id @default(cuid())
  childId      String
  child        Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  wakeupItemId String
  wakeupItem   WakeupItem @relation(fields: [wakeupItemId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  checked      Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  ledgerEntries PointLedger[]

  @@unique([childId, wakeupItemId, date])
}

// Weekly subject feedback from the teacher (Social Studies, Reading, Writing…).
// Unlike Task/TaskInstance (daily) or Wakeup/Bedtime (also daily), this only
// needs one checkbox per subject per week, so logs key on weekStart instead
// of a calendar date.
model SubjectItem {
  id        String   @id @default(cuid())
  label     String
  points    Int      @default(1)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  logs SubjectLog[]
}

model SubjectLog {
  id            String      @id @default(cuid())
  childId       String
  child         Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  subjectItemId String
  subjectItem   SubjectItem @relation(fields: [subjectItemId], references: [id], onDelete: Cascade)
  weekStart     DateTime    @db.Date
  checked       Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  ledgerEntries PointLedger[]

  @@unique([childId, subjectItemId, weekStart])
}

// A tier a kid has manually opened in the animal collection. Reaching the
// star threshold only makes a tier eligible ("ready to open" in the UI) —
// this row is what actually reveals it, so the unlock stays a deliberate,
// celebratory tap rather than something that silently changes color.
model AnimalUnlock {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  threshold  Int
  unlockedAt DateTime @default(now())

  @@unique([childId, threshold])
}

// Same open-it-yourself mechanic as AnimalUnlock, but the tier reached also
// becomes the child's avatar (Header, login screen) — see lib/dragonball.ts.
model DragonBallUnlock {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  threshold  Int
  unlockedAt DateTime @default(now())

  @@unique([childId, threshold])
}

// ─── Chat ───────────────────────────────────────────────────────────────
// Members and senders are either a Child or a Parent, so they're stored as
// (kind, personId) rather than foreign keys — deleting a test child doesn't
// get blocked by its chat history. See lib/chat.ts.

enum PersonKind {
  CHILD
  PARENT
}

model Conversation {
  id            String   @id @default(cuid())
  title         String?
  // "family" for the default whole-family group (created on demand).
  slug          String?  @unique
  // Sorted "KIND:id|KIND:id" of the two people in a 1-1 chat, so each pair
  // only ever gets one conversation.
  directKey     String?  @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  members  ConversationMember[]
  messages ChatMessage[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           PersonKind
  personId       String
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, kind, personId])
  @@index([kind, personId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderKind     PersonKind
  senderId       String
  // For a sticker, body holds the sticker's emoji (so previews/notifications
  // read naturally) and stickerId its key in lib/stickers.ts.
  body           String
  stickerId      String?
  createdAt      DateTime     @default(now())

  replyToId String?
  replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReplies")

  // @mentions parsed from body at send time (see lib/mentions.ts) — "everyone"
  // vs specific people ("KIND:id" keys) so notifications can flag them.
  mentionsEveryone Boolean  @default(false)
  mentionedKeys    String[] @default([])

  @@index([conversationId, createdAt])
}
